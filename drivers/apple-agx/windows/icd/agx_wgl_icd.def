; EXP1176: Mesa gallium_wgl.def (src/gallium/targets/wgl) with the context, swap and present
; entry points routed through agx_wgl_glthread.c, which enables and finishes glthread.
EXPORTS
	; stdcall calling convention have @number suffix on 32 bits architecture for gcc
	DrvCopyContext=AgxWglDrvCopyContext
	DrvCreateContext=AgxWglDrvCreateContext
	DrvCreateLayerContext=AgxWglDrvCreateLayerContext
	DrvDeleteContext=AgxWglDrvDeleteContext
	DrvDescribeLayerPlane
	DrvDescribePixelFormat
	DrvGetLayerPaletteEntries
	DrvGetProcAddress
	DrvPresentBuffers=AgxWglDrvPresentBuffers
	DrvRealizeLayerPalette
	DrvReleaseContext=AgxWglDrvReleaseContext
	DrvSetCallbackProcs
	DrvSetContext=AgxWglDrvSetContext
	DrvSetLayerPaletteEntries
	DrvSetPixelFormat
	DrvShareLists=AgxWglDrvShareLists
	DrvSwapBuffers=AgxWglDrvSwapBuffers
	DrvSwapLayerBuffers=AgxWglDrvSwapLayerBuffers
	DrvValidateVersion

	; __cdecl calling convention have no @number suffix
	st_context_flush
	st_context_teximage
	st_screen_destroy
	stw_get_device
	stw_init_screen
	stw_get_current_context
	stw_get_current_dc
	stw_pixelformat_choose
	stw_pixelformat_get
	stw_pixelformat_get_info
	stw_override_opengl32_entry_points
	stw_create_context_attribs
	stw_destroy_context
	stw_unbind_context
	stw_current_context
	stw_make_current
	stw_framebuffer_create
	stw_framebuffer_release_locked
	stw_framebuffer_unlock
	stw_framebuffer_swap_locked
	stw_get_framebuffer_resource
	stw_pbuffer_create
	stw_create_image_from_texture
	stw_create_image_from_renderbuffer
	stw_destroy_image
	stw_translate_image
	stw_get_config_xml
	stw_interop_query_device_info
	stw_interop_export_object
	stw_interop_flush_objects

	_mesa_glapi_get_proc_address
	_mesa_glapi_get_dispatch
