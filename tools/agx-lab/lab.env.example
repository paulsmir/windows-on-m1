# AGX lab configuration (bash syntax). Copy to <main checkout>/.local/agx-lab.env
# (untracked) or point AGX_LAB_ENV at another file. Every lab script sources it
# through lib.sh; nothing host-specific is tracked in the repository.

# Checkout with an initialized m1n1_windows submodule: run_uefi.py, the m1n1
# proxyclient and scripts/air-serial-guard.py are taken from here.
AGX_REPO=/path/to/public_windows/.worktrees/integration-branch

# Private experiment root: one directory per experiment (EXPnnnn-short-name).
AGX_EXPERIMENTS=/path/to/public_windows/.local/experiments

# Windows guest on the J313 (OpenSSH server). Home in forward-slash form.
AGX_GUEST=user@guest-address
AGX_GUEST_KEY=$HOME/.ssh/guest_key
AGX_GUEST_KNOWN_HOSTS=/path/to/known_hosts
AGX_GUEST_HOME=C:/Users/user

# Windows ARM64/x64 builder with the WDK, MSBuild and the pinned toolchains.
AGX_BUILDER=user@builder-address
AGX_BUILDER_KEY=$HOME/.ssh/builder_key
AGX_BUILDER_HOME=C:/Users/user

# m1n1 USB serial devices: the proxy port first, then the secondary port.
AGX_SERIAL_PORTS="/dev/cu.usbmodemXXXXXXXXXXXX41 /dev/cu.usbmodemXXXXXXXXXXXX43"

# Python environment with the m1n1 proxyclient dependencies (pyserial, construct).
AGX_PROXY_PYTHON=/path/to/proxyenv/bin/python

# Guest-side binaries copied by the probes.
AGX_VSYNC_TRACE=/path/to/AppleAgxVsyncTrace.exe
AGX_SELFTEST_DIR=/path/to/selftest-binaries   # agx_nolayout_selftest.exe, agx_vid_selftest.exe
