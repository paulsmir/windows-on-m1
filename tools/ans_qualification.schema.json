{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANS001 sealed evidence, not execution permission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "experiment",
    "platform",
    "storage_mode",
    "scope",
    "read_only",
    "launch",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "apple-ans-qualification/v1"
    },
    "experiment": {
      "const": "ANS001"
    },
    "platform": {
      "const": "J313"
    },
    "storage_mode": {
      "const": "ANS_NATIVE"
    },
    "scope": {
      "const": "ans0-unbound-no-driver"
    },
    "read_only": {
      "const": true
    },
    "launch": {
      "const": {
        "display": "physical",
        "debug": "uart",
        "low_mem": true,
        "cpu_count": 8,
        "no_pin": false,
        "wdt_cpu": null,
        "agx_power_broker": false,
        "chainload": true,
        "boot_source": "preloaded-ramdisk"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m1n1",
        "mu",
        "winpe",
        "layout",
        "broker_config",
        "broker_abi",
        "m1n1_build",
        "mu_build",
        "winpe_audit",
        "winpe_collector",
        "qualification_audit"
      ],
      "properties": {
        "m1n1": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
