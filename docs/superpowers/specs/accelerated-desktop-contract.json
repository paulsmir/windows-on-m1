{
  "schema_version": 1,
  "goal": "accelerated-windows-desktop",
  "kmd_model": "WDDM3.0",
  "umd_ddi": "D3D10_0_DDI_INTERFACE_VERSION",
  "feature_level": "D3D_FEATURE_LEVEL_10_0",
  "frontend": "mesa-d3d-reuse",
  "mesa_commit": "9aa1215f878b504f66159dd2ead4c7973142126e",
  "mandatory_inventory_reviewed": true,
  "advertised_pipeline_mask": 0,
  "selected_pipeline_mask": 1,
  "selection": {
    "status": "planning-selected-not-implemented",
    "accepted": "Reuse Mesa d3d10umd DDI/state translation and replace its software target/DRM winsys with the AppleAgx Windows transport.",
    "rejected": "thin-d3d-over-mesa",
    "rejected_reason": "It would duplicate the 101-entry D3D10 DDI/state surface already present in pinned Mesa before reaching the same Gallium/AGX backend.",
    "caveats": [
      "Pinned Mesa d3d10umd is currently software-targeted and SUPPORT_D3D11 is disabled.",
      "Its OpenResource path is unsupported and its current DXGI return disables redirection.",
      "Asahi BO, syncobj, submit, and fence paths are DRM/fd based and require an owned Windows winsys.",
      "The Asahi vertex/fragment state path accepts TGSI through tgsi_to_nir; this is source support, not Windows build or hardware proof."
    ]
  },
